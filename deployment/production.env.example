# Private production runtime template. Set actual values in the cPanel environment.
# This file contains no usable credentials. Never place it in the document root.
NODE_ENV=production
APP_ORIGIN=https://lms.YOUR-DOMAIN
COOKIE_SECURE=true
LOG_LEVEL=info
DATABASE_URL=postgres://cbid_app:CHANGE_ME_APP_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full
DB_POOL_MAX=3
DB_STATEMENT_TIMEOUT_MS=10000
UPLOAD_DIR=/home/ACCOUNT/lms/shared/uploads
MAX_UPLOAD_MB=10
TRUST_PROXY=false
# HOST and PORT must match the verified application manager mapping.
# REDIS_URL is unnecessary for the qualified single-process setup.
# Separate owner/job configuration must remain private, outside this app root.
# Jobs additionally require DATABASE_OWNER_URL, SMTP_URL and MAIL_FROM.
